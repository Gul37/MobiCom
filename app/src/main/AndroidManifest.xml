<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+: телефон, пошта, браузер қосымшаларын Intent арқылы табу үшін -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:name=".MobiComApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="MobiCom"
        android:supportsRtl="true"
        android:theme="@style/Theme.MobiCom">

        <!-- 1-Activity: іске қосылатын экран -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Негізгі экран: фрагменттер осында ауысады -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Тариф сипаттамасы: Intent арқылы дерек алады, нәтиже қайтарады -->
        <activity
            android:name=".TariffDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Админ: абоненттер мен сатып алулар статистикасы -->
        <activity
            android:name=".AdminActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Аудио: рингтондар -->
        <activity
            android:name=".RingtonesActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Бейне -->
        <activity
            android:name=".PromoActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false" />

        <!-- Таңдалған тілді сақтау (API 33-ке дейін) -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>
