<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mobi_bg"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:id="@+id/splashLogo"
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:background="@drawable/bg_logo"
        android:gravity="center"
        android:text="M"
        android:textColor="@color/mobi_night"
        android:textSize="56sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/splashTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="MobiCom"
        android:textColor="@color/mobi_text"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/splashSlogan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/slogan"
        android:textColor="@color/mobi_muted"
        android:textSize="14sp" />
</LinearLayout>
