<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/topup_title"
            android:textColor="@color/mobi_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/topUpLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/mobi_orange"
            android:textSize="24sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/topUpSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="99" />

        <EditText
            android:id="@+id/topUpAmount"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:hint="@string/hint_amount"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="6"
            android:textColor="@color/mobi_text"
            android:textColorHint="@color/mobi_muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/pay_method"
            android:textColor="@color/mobi_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/methodGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/payCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/pay_card"
                android:textColor="@color/mobi_text" />

            <RadioButton
                android:id="@+id/payKaspi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pay_kaspi"
                android:textColor="@color/mobi_text" />

            <RadioButton
                android:id="@+id/payTerminal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pay_terminal"
                android:textColor="@color/mobi_text" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/receiptCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/topup_receipt"
            android:textColor="@color/mobi_text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/topup_sms_label"
                android:textColor="@color/mobi_text" />

            <ToggleButton
                android:id="@+id/smsToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textOff="@string/toggle_off"
                android:textOn="@string/toggle_on" />
        </LinearLayout>

        <Button
            android:id="@+id/topUpButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="@string/btn_pay"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
