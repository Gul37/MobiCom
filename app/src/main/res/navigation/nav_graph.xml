<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.mobicom.ui.auth.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.mobicom.ui.auth.RegisterFragment"
        android:label="Register">
        <action
            android:id="@+id/action_register_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.mobicom.ui.home.HomeFragment"
        android:label="Home" />

    <fragment
        android:id="@+id/tariffsFragment"
        android:name="com.example.mobicom.ui.tariffs.TariffsFragment"
        android:label="Tariffs">
        <action
            android:id="@+id/action_tariffs_to_detail"
            app:destination="@id/tariffDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/tariffDetailFragment"
        android:name="com.example.mobicom.ui.tariffs.TariffDetailFragment"
        android:label="Tariff detail">
        <argument
            android:name="tariffId"
            app:argType="integer" />
        <action
            android:id="@+id/action_detail_to_topUp"
            app:destination="@id/topUpFragment" />
    </fragment>

    <fragment
        android:id="@+id/topUpFragment"
        android:name="com.example.mobicom.ui.topup.TopUpFragment"
        android:label="Top up" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.mobicom.ui.profile.ProfileFragment"
        android:label="Profile">
        <action
            android:id="@+id/action_profile_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>
</navigation>
